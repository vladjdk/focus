{
  "name": "focus",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node server.mjs --dev",
    "build": "vite build",
    "start": "node server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "version": "node scripts/changelog.mjs stamp && git add CHANGELOG.md",
    "release": "git push --follow-tags",
    "service:install": "sh scripts/service.sh install",
    "service:uninstall": "sh scripts/service.sh uninstall",
    "service:restart": "sh scripts/service.sh restart",
    "service:status": "sh scripts/service.sh status",
    "service:logs": "sh scripts/service.sh logs"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "^1.31.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "^7.1.0"
  }
}
